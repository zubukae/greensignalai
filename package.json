{
  "name": "greensignal-ai",
  "version": "1.0.0",
  "description": "GreenSignalAI - Intelligent Disaster Response & Resource Optimization Platform",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}