datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User Roles for Multi-Tier Authorization
enum Role {
  CITIZEN
  WORKER
  COORDINATOR
  PLANNER
  ADMIN
}

// Administrative Hierarchy Tiers
enum NodeTier {
  COUNTRY
  DIVISION
  DISTRICT
  UPAZILA
}

// Environmental Sensor Metric Categories
enum SensorType {
  WATER
  WIND
  SALINITY
  SEISMOGRAPH
  RAINFALL
}

// Operational Status for Hardware & Nodes
enum NodeStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

// Severity Levels for System & Citizen Alerts
enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  VERIFIED
  ACTIVE
  CONTAINED
  RESOLVED
  REJECTED
  DUPLICATE
}

enum IncidentUpdateType {
  REPORT_SUBMITTED
  GENERAL
  VERIFICATION
  STATUS_CHANGE
  FIELD_REPORT
  RESOLUTION
}

enum IncidentReportSource {
  CITIZEN
  STAFF
  DEMONSTRATION
}

enum ResponseTaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ResponseTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ShelterVerificationStatus {
  UNVERIFIED
  VERIFIED
  NEEDS_REVIEW
}

enum CoordinationGroupStatus {
  ACTIVE
  CLOSED
}

enum CoordinationGroupRole {
  LEADER
  MEMBER
}

// Status Lifecycle for Simulation Response Policies
enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// --- CORE MODELS ---

// 1. User Accounts (Citizens, Workers, Coordinators, Planners, Admins)
model User {
  id             String               @id @default(uuid())
  username       String               @unique
  email          String               @unique
  passwordHash   String
  fullName       String
  role           Role                 @default(CITIZEN)
  phone          String?
  organization   String?              // e.g., "DDM", "Red Cross", "Fire Service", "Planning Board"
  districtNodeId String?
  districtNode   AdministrativeNode?  @relation(fields: [districtNodeId], references: [id], onDelete: SetNull)
  
  // JSON Storage Column for Direct In-App User Messages & Direct Notifications
  messages       Json                 @default("[]")
  messagingPublicKey Json?
  messagingSigningPublicKey Json?
  messagingPrivateKeyVault Json?
  
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  chatMessages   ChatMessage[]
  createdIncidents DisasterIncident[] @relation("IncidentReporter")
  incidentUpdates IncidentUpdate[] @relation("IncidentUpdateAuthor")
  ledGroups       CoordinationGroup[] @relation("GroupLeader")
  groupMemberships CoordinationGroupMember[]
  volunteerProfile VolunteerProfile?
  assignedResponseTasks ResponseTaskAssignee[]
  createdResponseTasks ResponseTask[] @relation("ResponseTaskCreator")
  taskUpdates ResponseTaskUpdate[]
  notifications UserNotification[]
  alertSubscriptions AlertSubscription[]
  uploadedIncidentAttachments IncidentAttachment[]
  operationalAudits OperationalAudit[] @relation("OperationalAuditActor")
  verifiedShelters ReliefCenter[] @relation("ShelterVerifier")
  shelterUpdates ShelterOccupancyUpdate[]

  @@map("users")
}

// 2. 4-Tier Administrative Node Network (Country -> Division -> District -> Upazila)
model AdministrativeNode {
  id           String               @id @default(uuid())
  name         String               // e.g., "Adamdighi", "Bogura", "Rajshahi", "Bangladesh National HQ"
  tier         NodeTier             // COUNTRY, DIVISION, DISTRICT, UPAZILA
  code         String               @unique // e.g., "UPZ-BOGURA-ADAMDIGHI"
  
  // Self-referential Directed Graph Hierarchy
  parentId     String?
  parent       AdministrativeNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     AdministrativeNode[] @relation("NodeHierarchy")

  // Geographic Spatial Coordinates
  latitude     Float?
  longitude    Float?

  // Native JSON Storage Fields for Dynamic Telemetry & State
  inventory        Json  @default("{\"food_packs\": 0, \"water_liters\": 0, \"medical_kits\": 0, \"dry_food_bags\": 0, \"emergency_tents\": 0}")
  requirements     Json  @default("{\"food_packs_needed\": 0, \"water_liters_needed\": 0, \"medical_kits_needed\": 0, \"tents_needed\": 0}")
  affectedPeople   Json  @default("{\"total_affected\": 0, \"displaced\": 0, \"injured\": 0, \"casualties\": 0, \"vulnerable_groups\": {\"children\": 0, \"elderly\": 0, \"pregnant\": 0}}")
  sensorData       Json  @default("{\"water_level_m\": 0.0, \"rainfall_mm\": 0.0, \"wind_speed_kmh\": 0.0, \"pressure_hpa\": 1012.0, \"salinity_ppt\": 0.0, \"seismic_magnitude\": 0.0, \"storm_probability_pct\": 0, \"quake_probability_pct\": 0, \"flood_risk\": \"NORMAL\", \"status\": \"NORMAL\"}")
  incidents        Json  @default("[]")
  situationReport  Json  @default("{\"status\": \"STABLE\", \"summary\": \"Normal operations\", \"last_updated\": \"\", \"updated_by\": \"\"}")
  messages         Json  @default("[]")

  // Relationships
  users        User[]
  sensors      SensorNode[]
  shelters     ReliefCenter[]
  incidentReports DisasterIncident[]
  coordinationGroups CoordinationGroup[]
  responseTasks ResponseTask[]
  volunteerProfiles VolunteerProfile[]
  alertSubscriptions AlertSubscription[]
  operationalAudits OperationalAudit[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("administrative_nodes")
}

// 3. Sensor Hardware Infrastructure (WATER, WIND, SALINITY, SEISMOGRAPH, RAINFALL with Time-Series & Predictive Analytics)
model SensorNode {
  id               String              @id @default(uuid())
  sensorCode       String              @unique // e.g., "SN-UPZ-ADAMDIGHI-WATER"
  districtNodeId   String
  districtNode     AdministrativeNode  @relation(fields: [districtNodeId], references: [id], onDelete: Cascade)
  type             SensorType
  latitude         Float
  longitude        Float
  metricValue      String              // Live displayed metric (e.g., "4.8m", "74 km/h • 991 hPa", "3.8 M Foreshock", "92mm • 29°C")
  currentValue     Float?              // Numeric primary value
  unit             String?             // e.g., "m", "km/h", "hPa", "Richter (M)", "mm/24h", "ppt", "°C"
  dangerThreshold  Float?              // Critical threshold
  warningThreshold Float?              // Early warning watch threshold
  timeSeries       Json                @default("[]") // Array of timestamped historical sensor readings
  forecastSeries   Json                @default("[]") // Array of predicted future points with confidence intervals
  analytics        Json                @default("{}") // Domain specific predictive calculations (storm chance %, flood crest eta, earthquake hazard %)
  status           NodeStatus          @default(ACTIVE)
  lastPing         DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("sensor_nodes")
}

// 4. Emergency Relief Centers & Shelters (1 Per Upazila with 4 JSON Stock Columns)
model ReliefCenter {
  id                    String              @id @default(uuid())
  centerCode            String              @unique // e.g., "RC-UPZ-ADAMDIGHI"
  name                  String
  districtNodeId        String
  districtNode          AdministrativeNode  @relation(fields: [districtNodeId], references: [id], onDelete: Cascade)
  latitude              Float
  longitude             Float
  capacity              Int                 @default(500)
  occupancy             Int                 @default(0)
  contactNum            String?
  isOperational         Boolean             @default(true)

  // 1) Stock Policy: Required readiness allocations (beds, food, medicine, vehicles, tents)
  stockPolicy           Json                @default("{\"beds\": 500, \"food_packs\": 1000, \"medical_kits\": 200, \"vehicles\": 5, \"tents\": 50}")

  // 2) Current Stock: On-hand available inventory
  currentStock          Json                @default("{\"beds\": 350, \"food_packs\": 700, \"medical_kits\": 120, \"vehicles\": 3, \"tents\": 30}")

  // 3) Emergency Requirement: Immediate active crisis deficit
  emergencyRequirement  Json                @default("{\"beds\": 50, \"food_packs\": 100, \"medical_kits\": 20, \"vehicles\": 1, \"tents\": 10}")

  // 4) Restocking Requirement: Delta between Policy and Current Stock
  restockingRequirement Json                @default("{\"beds\": 150, \"food_packs\": 300, \"medical_kits\": 80, \"vehicles\": 2, \"tents\": 20}")

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  verificationStatus    ShelterVerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?               @relation("ShelterVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  occupancyUpdates      ShelterOccupancyUpdate[]

  @@map("relief_centers")
}

model VolunteerProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  administrativeNodeId String?
  administrativeNode AdministrativeNode? @relation(fields: [administrativeNodeId], references: [id], onDelete: SetNull)
  skills          String[]           @default([])
  isAvailable     Boolean            @default(false)
  availabilityNote String?           @db.VarChar(500)
  updatedAt       DateTime           @updatedAt
  createdAt       DateTime           @default(now())

  @@index([administrativeNodeId, isAvailable])
  @@map("volunteer_profiles")
}

model ResponseTask {
  id                  String               @id @default(uuid())
  title               String               @db.VarChar(160)
  description         String               @db.Text
  status              ResponseTaskStatus   @default(OPEN)
  priority            ResponseTaskPriority @default(NORMAL)
  dueAt               DateTime?
  incidentId          String?
  incident            DisasterIncident?    @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  administrativeNodeId String
  administrativeNode  AdministrativeNode   @relation(fields: [administrativeNodeId], references: [id], onDelete: Restrict)
  createdById         String
  createdBy           User                 @relation("ResponseTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees           ResponseTaskAssignee[]
  updates             ResponseTaskUpdate[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  completedAt         DateTime?

  @@index([administrativeNodeId, status, createdAt])
  @@index([incidentId, status])
  @@map("response_tasks")
}

model ResponseTaskAssignee {
  taskId    String
  userId    String
  assignedAt DateTime       @default(now())
  task      ResponseTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, assignedAt])
  @@map("response_task_assignees")
}

model ResponseTaskUpdate {
  id        String             @id @default(uuid())
  taskId    String
  task      ResponseTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  status    ResponseTaskStatus
  note      String             @db.Text
  createdAt DateTime           @default(now())

  @@index([taskId, createdAt])
  @@map("response_task_updates")
}

model UserNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(160)
  body      String   @db.VarChar(1000)
  entityType String? @db.VarChar(50)
  entityId   String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@map("user_notifications")
}

model AlertSubscription {
  id                    String             @id @default(uuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  administrativeNodeId  String
  administrativeNode   AdministrativeNode @relation(fields: [administrativeNodeId], references: [id], onDelete: Cascade)
  hazardTypes           String[]           @default([])
  minimumSeverity       AlertSeverity      @default(INFO)
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([userId, administrativeNodeId])
  @@index([administrativeNodeId, isActive])
  @@map("alert_subscriptions")
}

model IncidentAttachment {
  id          String          @id @default(uuid())
  incidentId  String
  incident    DisasterIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy  User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  fileName    String          @db.VarChar(255)
  contentType String          @db.VarChar(100)
  fileSize    Int
  content     Bytes
  createdAt   DateTime        @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_attachments")
}

model ShelterOccupancyUpdate {
  id             String       @id @default(uuid())
  reliefCenterId String
  reliefCenter   ReliefCenter @relation(fields: [reliefCenterId], references: [id], onDelete: Cascade)
  updatedById   String
  updatedBy     User         @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  previousOccupancy Int
  occupancy     Int
  note          String?      @db.VarChar(500)
  createdAt     DateTime     @default(now())

  @@index([reliefCenterId, createdAt])
  @@map("shelter_occupancy_updates")
}

model OperationalAudit {
  id                   String             @id @default(uuid())
  actorId              String?
  actor                User?              @relation("OperationalAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  administrativeNodeId String?
  administrativeNode   AdministrativeNode? @relation(fields: [administrativeNodeId], references: [id], onDelete: SetNull)
  action               String             @db.VarChar(80)
  entityType           String             @db.VarChar(50)
  entityId             String
  details              Json               @default("{}")
  createdAt            DateTime           @default(now())

  @@index([administrativeNodeId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("operational_audits")
}

// 5. Multi-Tier Worker & NGO Chat Communication System
model ChatMessage {
  id                String            @id @default(uuid())
  channel           String
  text              String            @db.Text
  encryptionIv      String?
  encryptedKeys     Json?
  encryptionSignature String?
  encryptionVersion Int?
  senderId          String
  sender            User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  groupId           String?
  group             CoordinationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@index([channel, createdAt])
  @@index([groupId, createdAt])
  @@map("chat_messages")
}

// 6. Structured disaster operations and incident-linked coordination groups
model DisasterIncident {
  id             String        @id @default(uuid())
  referenceCode  String?       @unique
  title          String
  description    String?       @db.Text
  hazardType     String
  reportSource   IncidentReportSource @default(CITIZEN)
  severity       AlertSeverity @default(WARNING)
  status         IncidentStatus @default(REPORTED)
  division       String?
  district       String
  upazila        String?
  unionName      String?
  ward           String?
  village        String?
  latitude       Float?
  longitude      Float?
  peopleAffected Int           @default(0)
  householdsDisplaced Int       @default(0)
  peopleInjured  Int           @default(0)
  fatalities     Int           @default(0)
  sheltersImpacted Int         @default(0)
  rainfall24hMm  Float?
  riverLevelM    Float?
  windSpeedKmh   Float?
  stormSurgeM    Float?
  seismicMagnitude Float?
  situationReport String?      @db.Text
  statusAccessTokenHash String? @unique
  alertId        String?
  alert          DisasterAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  administrativeNodeId String?
  administrativeNode AdministrativeNode? @relation(fields: [administrativeNodeId], references: [id], onDelete: SetNull)
  reportedById   String?
  reportedBy     User?         @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  updates        IncidentUpdate[]
  attachments    IncidentAttachment[]
  groups         CoordinationGroup[]
  responseTasks  ResponseTask[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  resolvedAt     DateTime?

  @@index([district, upazila, status])
  @@index([administrativeNodeId, status])
  @@index([alertId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([severity, administrativeNodeId, createdAt])
  @@map("disaster_incidents")
}

model IncidentUpdate {
  id        String             @id @default(uuid())
  incidentId String
  incident  DisasterIncident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?              @relation("IncidentUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  type      IncidentUpdateType
  content   String             @db.Text
  fromStatus IncidentStatus?
  toStatus  IncidentStatus?
  createdAt DateTime           @default(now())

  @@index([incidentId, createdAt])
  @@index([authorId, createdAt])
  @@map("incident_updates")
}

model CoordinationGroup {
  id          String                   @id @default(uuid())
  channel     String                   @unique
  name        String
  status      CoordinationGroupStatus  @default(ACTIVE)
  incidentId  String?
  incident    DisasterIncident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  scopeNodeId String?
  scopeNode   AdministrativeNode?      @relation(fields: [scopeNodeId], references: [id], onDelete: SetNull)
  leaderId    String
  leader      User                     @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members     CoordinationGroupMember[]
  messages    ChatMessage[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  closedAt    DateTime?

  @@index([status, createdAt])
  @@index([incidentId, status])
  @@index([scopeNodeId, status])
  @@map("coordination_groups")
}

model CoordinationGroupMember {
  groupId   String
  userId    String
  role      CoordinationGroupRole @default(MEMBER)
  joinedAt  DateTime              @default(now())
  group     CoordinationGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, joinedAt])
  @@map("coordination_group_members")
}

// 7. Citizen Disaster Broadcast Alerts
model DisasterAlert {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  district    String        // Target district or "NATIONWIDE"
  hazardType  String?
  severity    AlertSeverity @default(WARNING)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  incidents   DisasterIncident[]

  @@map("disaster_alerts")
}

// 8. Planner Disaster Response Policies
model ResponsePolicy {
  id              String         @id @default(uuid())
  name            String         // e.g., "Cost-Minimized Pre-positioning v1"
  description     String?        @db.Text
  status          PolicyStatus   @default(DRAFT)
  tierScope       NodeTier       @default(COUNTRY)

  triggers        Json           // Operational activation thresholds
  allocationRules Json           // Per capita supply ratios & safety buffers
  priorityWeights Json           // Multi-criteria optimization weights
  costParameters  Json           // Unit transport, holding, and unmet demand penalties

  simulations     SimulationRun[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("response_policies")
}

// 9. Simulation Execution Results & Scorecards
model SimulationRun {
  id                  String          @id @default(uuid())
  scenarioName        String          // e.g., "Category 4 Cyclone Simulation"
  policyId            String
  policy              ResponsePolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  
  totalCost           Float
  totalTransportCost  Float
  totalHoldingCost    Float
  totalPenaltyCost    Float
  fulfillmentRate     Float
  optimizedAllocation Json

  runBy               String
  createdAt           DateTime        @default(now())

  @@map("simulation_runs")
}
